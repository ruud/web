        },
        "body": {
          "id": "1",
          "profile": {
            "firstName": "John",
            "lastName": "Doe",
            "address": {
              "street": "123 Main St",
              "city": "Springfield",
              "zipCode": "12345"
            },
            "preferences": {
              "theme": "dark",
              "notifications": true
            }
          }
        },
        "matchingRules": {
          "$.body.id": {
            "matchers": [
