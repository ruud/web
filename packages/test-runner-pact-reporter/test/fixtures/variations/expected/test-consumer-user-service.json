                "match": "type"
              }
            ]
          },
          "$.body.profile.firstName": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.lastName": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.address.street": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.address.city": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.address.zipCode": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.preferences.theme": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.body.profile.preferences.notifications": {
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    },
    "client": {
      "name": "pact-msw-adapter-wtr",
      "version": "1.0.0"
    }
  }
